      "name": "Historical Data",
      "description": {
        "content": "This API includes endpoints that allow you to retrieve raw `Signal` Data for a specified period. \n      The data requested is compiled into a file that you can download posteriorly.",
        "type": "text/plain"
      },
      "item": [
