          "name": "Create Async Data Request",
          "request": {
            "name": "Create Async Data Request",
            "description": {
              "content": "This endpoint creates a data request and responds immediately while the data is being processed in the background. \n        The response will contain a `status`, indicating if the request is running or if it failed, \n        and a `requestId` field that can be used to check the status of the request using the \n        [Get Data Request](#tag/historicalData/paths/~1api~1v1~1historical-data~1%7BrequestId%7D/get). \n        The field `outputFile` indicates the URL to download the output file, when ready.",
              "type": "text/plain"
            },
